{
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",

    "target": "ES2022",
    "module": "preserve",
    "moduleResolution": "bundler",

    "allowImportingTsExtensions": true,
    "noEmit": true,

    "resolveJsonModule": true,
    "verbatimModuleSyntax": true,

    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,

    "types": ["node"]
  },
  "include": ["src/**/*.ts"]
}