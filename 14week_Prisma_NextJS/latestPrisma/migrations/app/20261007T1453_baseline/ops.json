  {
    "id": "unique.Person.Person_email_key",
    "label": "Add unique constraint on \"Person\" (email)",
    "operationClass": "additive",
    "target": {
      "id": "postgres",
      "details": {
        "schema": "public",
        "objectType": "unique",
        "name": "Person_email_key",
        "table": "Person"
      }
    },
    "precheck": [
      {
        "description": "ensure constraint \"Person_email_key\" does not exist",
        "sql": "SELECT NOT EXISTS (SELECT 1 AS \"one\" FROM \"pg_constraint\" AS \"c\" INNER JOIN \"pg_namespace\" AS \"n\" ON \"n\".\"oid\" = \"c\".\"connamespace\" WHERE (\"c\".\"conname\" = $1 AND \"n\".\"nspname\" = $2 AND \"c\".\"conrelid\" = to_regclass($3))) AS \"result\"",
        "params": [
          "Person_email_key",
          "public",
          "\"public\".\"Person\""
        ]
      }
    ],
    "execute": [
      {
        "description": "add unique constraint \"Person_email_key\"",
        "sql": "ALTER TABLE \"public\".\"Person\" ADD CONSTRAINT \"Person_email_key\" UNIQUE (\"email\")"
      }
    ],
    "postcheck": [
      {
        "description": "verify constraint \"Person_email_key\" exists",
        "sql": "SELECT EXISTS (SELECT 1 AS \"one\" FROM \"pg_constraint\" AS \"c\" INNER JOIN \"pg_namespace\" AS \"n\" ON \"n\".\"oid\" = \"c\".\"connamespace\" WHERE (\"c\".\"conname\" = $1 AND \"n\".\"nspname\" = $2 AND \"c\".\"conrelid\" = to_regclass($3))) AS \"result\"",
        "params": [
          "Person_email_key",
          "public",
          "\"public\".\"Person\""
        ]
