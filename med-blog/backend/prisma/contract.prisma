// use prisma-8

model User {
    id          String      @id @default(uuid())
    username    String
    email       String      @unique
    password    String
    posts       Blog[]
}

model Blog {
    id          String      @id @default(uuid())
    authorId    String
    author      User        @relation(fields: [authorId], references: [id])
    title       String
    content     String
    published   Boolean     @default(false) 
}

