// use prisma-8

enum AuthType {
  Google
  Github
}

enum OnRampStatus{
  Success
  Failure
  Processing
}

model User {
  id                  Int                   @id @default(autoincrement())
  email               String                @unique
  name                String?
  number              String                @unique
  password            String
  OnRampTransaction   OnRampTransaction[]
  Balance             Balance[]
}

model merchant {
  id          Int        @id @default(autoincrement())
  email       String     @unique
  name        String?
  auth_type   AuthType
}

model OnRampTransaction {
  id          Int        @id @default(autoincrement())
  status      OnRampStatus  // transaction [Success Failure Processing]
  token       String     @unique
  provider    String        // [hdfcbank, upi, card]
  amount      Int           // amt transferring
  startTime   DateTime
  userId      Int
  user        User        @relation(fields: [userId], references: [id])
}

model Balance {
  id      Int    @id @default(autoincrement())
  userId  Int    @unique
  amount  Int
  locked  Int
  user    User   @relation(fields: [userId], references: [id])
  // this balance is for this User
}


// - yarn prisma contract emit
